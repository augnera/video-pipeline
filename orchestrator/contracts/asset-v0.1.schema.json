{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assetId",
    "sourceType",
    "mediaType",
    "localPath",
    "sha256",
    "sourceUrl",
    "creator",
    "license",
    "licenseStatus",
    "durationSeconds",
    "width",
    "height",
    "fps",
    "description",
    "actions",
    "mood",
    "tags",
    "usableSegments",
    "reviewStatus",
    "analysis"
  ],
  "properties": {
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "sourceType": {
      "enum": [
        "local_library",
        "web_stock",
        "ai_generated",
        "user_provided"
      ]
    },
    "mediaType": {
      "enum": [
        "video",
        "image"
      ]
    },
    "localPath": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "creator": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sourceUrl",
        "verifiedAt",
        "restrictions",
        "localExperimentAllowed"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "localExperimentAllowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "attributionRequired": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "evidenceFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "licenseStatus": {
      "enum": [
        "verified_for_local_experiment",
        "local_experiment_only",
        "pending_verification",
        "unknown",
        "rejected"
      ]
    },
    "durationSeconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "width": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "height": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "fps": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mood": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usableSegments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "reviewStatus": {
      "enum": [
        "pending_human",
        "approved",
        "rejected"
      ]
    },
    "aspectRatio": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "analysis": {
      "type": "object",
      "required": [
        "model",
        "analyzedAt",
        "frameEvidence",
        "facts",
        "inferences",
        "uncertainty"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "analyzedAt": {
          "type": "string",
          "minLength": 1
        },
        "frameEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "timestampSeconds",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "timestampSeconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "generation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "object"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mediaType": {
            "const": "image"
          }
        }
      },
      "then": {
        "properties": {
          "durationSeconds": {
            "type": "null"
          },
          "fps": {
            "type": "null"
          },
          "usableSegments": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
