{
  "name": "video-pipeline-orchestrator",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "import:ip": "node --import tsx src/import/ip-cli.ts",
    "test:import": "node --import tsx --test src/import/excel.test.ts",
    "build": "tsc",
    "pipeline": "node --env-file=.env --import tsx src/index.ts",
    "record": "node --env-file=.env --import tsx src/record/demo-recorder.ts",
    "mvp:visual": "node --import tsx src/visual-mvp/entry.ts",
    "test:visual-mvp": "node --import tsx --test src/visual-mvp/core.test.ts src/visual-mvp/quality.test.ts",
    "produce": "node --import tsx src/production/cli.ts",
    "test:production": "node --import tsx --test src/production/production.test.ts",
    "assets": "python3 src/asset-library/library.py",
    "test:assets": "python3 -m unittest discover -s src/asset-library -p \"test_*.py\" -v",
    "assets:videoseek": "python3 src/asset-library/videoseek.py",
    "assets:web": "python3 src/asset-library/network.py"
  },
  "dependencies": {
    "fluent-ffmpeg": "2.1.3",
    "playwright": "1.61.1",
    "read-excel-file": "9.3.12",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "2.1.28",
    "@types/node": "22.20.0",
    "@types/ws": "8.18.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
